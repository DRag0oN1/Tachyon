{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tachyon.local/schemas/strategy-specification-v1",
  "title": "Tachyon Strategy Specification (abstract PPO evidence)",
  "type": "object",
  "required": ["schemaVersion", "id", "performanceDomain", "scenario", "evidence", "preferredScoringObjectives", "actionPriorities", "cycleTransitions", "movement", "representativeRollout", "capabilityRequirements", "mechanismRequirements", "tradeoffs", "limitations"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "performanceDomain": {"const": "abstract_simulation_only"},
    "scenario": {"type": "string"},
    "evidence": {
      "type": "object",
      "required": ["origin", "episodes", "capabilityConfigurations", "trainingSeeds", "checkpointParameterHashes", "meanScore"],
      "properties": {
        "origin": {"const": "trained_neural_ppo_rollouts"},
        "episodes": {"type": "integer", "minimum": 1},
        "capabilityConfigurations": {"type": "integer", "minimum": 1},
        "trainingSeeds": {"type": "array", "items": {"type": "string"}},
        "checkpointParameterHashes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
        "meanScore": {"type": "number"}
      }
    },
    "capabilityRequirements": {
      "type": "object",
      "required": ["hardMinimums", "targets", "jointReferenceCapabilities", "minimumScope", "targetBasis"],
      "properties": {
        "hardMinimums": {"type": "object", "required": ["reachM", "pinCapacity", "cupCapacity"], "properties": {"reachM": {"type": "number", "minimum": 0}, "pinCapacity": {"const": 1}, "cupCapacity": {"enum": [0, 1]}}},
        "targets": {"type": "object", "required": ["driveSpeedMps", "reachM", "acquisitionSeconds", "placementSeconds"]},
        "jointReferenceCapabilities": {"type": "object", "required": ["allocation", "max_reach_m"]},
        "minimumScope": {"type": "string"},
        "targetBasis": {"type": "string"}
      }
    },
    "mechanismRequirements": {"type": "array", "items": {"type": "string"}},
    "preferredScoringObjectives": {"type": "array"},
    "actionPriorities": {"type": "array"},
    "cycleTransitions": {"type": "array"},
    "movement": {"type": "object"},
    "representativeRollout": {"type": "object"},
    "tradeoffs": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
