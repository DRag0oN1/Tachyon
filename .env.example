# Server-side only. Configure privately; never copy secrets into Vite variables.
TACHYON_DATA_DIR=.local
TACHYON_CAD_PROFILE=user_provided_local
# External private roots; ~ expands locally. No geometry is installed by setup.
TACHYON_CAD_DIR=~/Documents/TachyonCAD/step
TACHYON_RIGHTS_DIR=~/Documents/TachyonCAD/rights
TACHYON_UI_ORIGIN=http://127.0.0.1:8000
TACHYON_AI_PROVIDER=openai
TACHYON_AI_MODEL=
OPENAI_API_KEY=
